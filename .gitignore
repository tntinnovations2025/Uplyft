# ── Environment & Secrets (STRICT) ───────────────────────────────────────────
# Never commit environment files. `.env.example` is the only tracked template.
.env
.env.backup
.env.*
!.env.example

# Local credentials/operational tooling that must never enter version control.
/open-mysql-cli.cmd
/start-mysql.cmd
/stop-mysql.cmd
/update_user.php
/scratch/
/.scratch/
/php/
/mysql/
/git/
/composer/
/design-system/b2b-saas-dashboard/

# ── Dependencies / Build Artifacts ───────────────────────────────────────────
/vendor
/node_modules
/public/build
/public/hot
/public/fonts-manifest.dev.json
/public/storage
/public/storage-link
/storage/*.key
/storage/pail

# ── Runtime Generated Files ──────────────────────────────────────────────────
/storage/framework/cache/*
/storage/framework/sessions/*
/storage/framework/views/*
/storage/logs/*
!/storage/framework/cache/.gitignore
!/storage/framework/sessions/.gitignore
!/storage/framework/views/.gitignore
!/storage/logs/.gitignore

# ── Tenant Uploads, Materials & Documents (never committed) ───────────────────
# LMS subject materials / courseware uploads (local disk)
/storage/app/private/subject-materials/*
/storage/app/private/*
/storage/app/materials/*

# Tenant-generated PDF invoices, vouchers, receipts, passports & photos
/storage/app/public/institutes/*
/storage/app/public/invoices/*
/storage/app/invoices/*
/storage/app/pdf/*

# Vector caches / embedding artifacts (DB-backed in this build; defensive)
/storage/app/vector/*
/storage/app/cache/*
/storage/app/storage/vector/*

# Security operational artifacts (e.g. password-rotation CSV hand-outs)
/storage/app/security/*

