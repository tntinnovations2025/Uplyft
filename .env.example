# ─────────────────────────────────────────────────────────────────────────────
# UPLYFT — Production Environment Template
# Copy to `.env`, fill in real values, and NEVER commit `.env` to version control.
# All values below are placeholders — replace them before deploying.
# ─────────────────────────────────────────────────────────────────────────────

APP_NAME=UPLYFT
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://uplyft.example.com
APP_TIMEZONE=Asia/Karachi

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

# Number of workers for `php artisan serve` (multi-process serving)
PHP_CLI_SERVER_WORKERS=4

# BCrypt cost factor. 12 is the recommended minimum for production.
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# ── Database (primary tenant database) ──────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=uplifyt_platform
DB_USERNAME=uplifyt_app
DB_PASSWORD=
# Uncomment if your MySQL driver requires TLS to the server.
# DB_SSLMODE=REQUIRED

# Per-institute databases (created dynamically at onboarding).
# e.g. prefix + zero-padded id => uplifyt_inst_01
INSTITUTE_DB_PREFIX=uplifyt_inst_

# Global Admin Emergency Override — enables access to tenant data (false by default).
# NEVER enable unless an authenticated global-admin recovery is genuinely required.
GLOBAL_ADMIN_EMERGENCY_OVERRIDE=false

# ── Boilerplate Seeds (DEV ONLY — never hard-code credentials in code) ──────
# Consumed by the standalone seed scripts (seed_admin.php, seed_module3_test.php,
# sync_seed.php) when they create demo accounts. Override in your local `.env`;
# the scripts source these values from the environment instead of the repo.
GLOBAL_ADMIN_EMAIL=admin@uplyft.com
GLOBAL_ADMIN_PASSWORD=
PRINCIPAL_DEFAULT_PASSWORD=
TEACHER_DEFAULT_PASSWORD=

# ── Session ─────────────────────────────────────────────────────────────────
# Database-backed sessions (recommended default). Switch to redis for multi-node.
SESSION_DRIVER=database
SESSION_LIFETIME=120
# true: encrypt session payloads at rest (recommended if sessions may hold PII)
SESSION_ENCRYPT=true
SESSION_PATH=/
# Must match the parent domain of all portal subdomains, e.g. .uplyft.example.com
SESSION_DOMAIN=.uplyft.example.com
# true in production: cookies only sent over HTTPS
SESSION_SECURE_COOKIE=true

# ── Broadcast / Queue / Cache ───────────────────────────────────────────────
BROADCAST_CONNECTION=log

# File storage driver. `local` writes to storage/app/private, `public` to storage/app/public.
FILESYSTEM_DISK=public

# Queue driver: [database | redis]. database has no daemon requirement and is safe
# for single-node; redis is recommended for multi-node production.
QUEUE_CONNECTION=database

# Cache store: [database | redis | memcached]. Set to redis when REDIS_* below are live.
CACHE_STORE=database
# CACHE_PREFIX=uplyft

# ── Redis (optional; used by redis cache/queue/session drivers) ──────────────
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Memcached (alternative cache backend)
MEMCACHED_HOST=127.0.0.1

# ── Email / SMTP ────────────────────────────────────────────────────────────
# smtp → real delivery | log → writes emails to laravel.log (never in production)
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_TRANSPORT=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
# SMTP credentials — treated as secrets; do not commit.
MAIL_USERNAME=change-me@example.com
MAIL_PASSWORD=
# Sender identity
MAIL_FROM_ADDRESS=noreply@uplyft.example.com
MAIL_FROM_NAME="UPLYFT"
# EHLO domain used during SMTP handshake (defaults to APP_URL host)
MAIL_EHLO_DOMAIN=uplyft.example.com

# ── AWS (only if S3 storage is used) ─────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ── Frontend (non-secret only; Vite never bundles non-VITE_ variables) ──────
VITE_APP_NAME="${APP_NAME}"

# ── LLM API (Module 6 RAG & Test Generator) — SECRET ────────────────────────
# GROQ_API_KEY is the single source of truth. LLM_API_KEY is optional and
# falls back to GROQ_API_KEY when left empty (see config/services.php).
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
LLM_PROVIDER=groq
LLM_API_KEY=

# ── Module 6 LMS RAG & Vector Engine ────────────────────────────────────────
EMBEDDING_PROVIDER=tfidf
EMBEDDING_DIMENSION=256
EMBEDDING_API_KEY=
# Max upload size in KB for LMS course materials (512 MB default). Note that
# PHP upload_max_filesize / post_max_size in php.ini must also allow it.
LMS_MAX_UPLOAD_SIZE_KB=524288
# Queue used for large-document ingestion (RAG chunking + embeddings).
# Default 'default' works with a single `php artisan queue:work`. For heavy
# workloads run a dedicated worker:
#   php artisan queue:work --queue=documents
# and switch to Redis + Laravel Horizon for multi-node (see composer config).
DOCUMENT_PROCESSING_QUEUE=default